# Newsletter Digest settings.
# The setup wizard creates your real ".env" for you - you normally never edit this by hand.
# This file just shows what the wizard stores. NEVER put your real values in this example file,
# and never commit your real .env to GitHub (.gitignore already blocks it).

# The Gmail address the digest reads newsletters from.
IMAP_EMAIL=you@gmail.com

# A 16-character Google APP PASSWORD (not your normal Gmail password).
# Requires 2-Step Verification. Create at: https://myaccount.google.com/apppasswords
IMAP_PASSWORD=your16charapppassword

# Where the finished digest is emailed to. Leave unset to send it to IMAP_EMAIL.
# RECIPIENT_EMAIL=you@gmail.com

# Your Groq API key (starts with gsk_). Create at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# The Groq model used to summarize. Change this if Groq retires a model -
# no code edit needed. See the model list at https://console.groq.com
DIGEST_MODEL=openai/gpt-oss-120b

# --- Optional, not used in Phase 1 (email only) ---
# Fill BOTH to also send the digest to Telegram.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
